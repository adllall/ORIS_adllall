      <Content Include="Control_work\.idea\workspace.xml" />
      <Content Include="HomeWork_8\settings.json" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="HomeWork_4\static\Image\" />
      <Folder Include="HomeWork_7\" />
      <Folder Include="Packages\" />
    </ItemGroup>
    <ItemGroup>
        <None Update="HomeWork_2\settings.json" CopyToOutputDirectory="PreserveNewest" />

        <None Update="HomeWork_2\Knowledge.html" CopyToOutputDirectory="PreserveNewest" />

        <None Update="HomeWork_4\static\Rockstar\rockstar.html">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>

        <None Update="HomeWork_4\static\SearchEnginer\time.html">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="HomeWork_3\settings.json" CopyToOutputDirectory="PreserveNewest" />

        <None Update="HomeWork_3\static\**\*" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>


    <ItemGroup>
        <None Update="HomeWork_4\settings.json" CopyToOutputDirectory="PreserveNewest" />

