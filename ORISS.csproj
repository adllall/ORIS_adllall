        </None>

        <None Update="HomeWork_8\**\*.html">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Npgsql" Version="9.0.5" />
    </ItemGroup>
</Project>
